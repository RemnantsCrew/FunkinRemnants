package funkin.remnants.gameplay;

import funkin.ui.story.Level;
import funkin.data.story.level.LevelRegistry;
import funkin.play.cutscene.VideoCutscene;

class RemnantsBumpers extends Module
{
  /**
   * Has the bumper been played already?
   */
  public var playedBumper:Bool = false;

  /**
   * Is the bumper currently playing?
   */
  public var isPlaying:Bool = false;

  /**
   * If we should automatically play the bumper.
   */
  public var disableAutoPlay:Bool = false;

  /**
   * What was the last song played?
   */
  public var lastSong:String = '';

  /**
   * What was the last week played?
   */
  public var lastWeek:String = '';

  /**
   * What's the current week being played?
   */
  public var currentWeek:String = '';

  /**
   * What was the last variation played?
   */
  public var lastVariation:String = '';

  /**
   * What's the current variation being played?
   */
  public var currentVariation:String = '';

  /**
   * Is the current song the first one being played on the week?
   */
  public var isFirstOfWeek(get, default):Bool = false;

  // For some songs, we change the level's name just so they have independent bumpers!
  public var specialCases:Map<String, Array<String>> = [
    "monster" => "week2-scary",
    "winter-horrorland" => "week5-scary",
    "thorns" => "week6-scary",
    "grieving-remnants" => "grieving",
  ];

  // Make fade from black and countdown start at the same time for these weeks.
  public var skipTransitionWeeks:Array<String> = ['week5-scary', 'week7'];

  public function new()
  {
    super('remnantsBumpers', -1000, {state: PlayState});
  }

  override public function onCountdownStart(event:CountdownScriptEvent):Void
  {
    super.onCountdownStart(event);
    if (disableAutoPlay) return;

    if (setupBumper())
    {
      trace("setupBumper() returned 'true', stopping the countdown...");
      event.cancel();
      event.stopPropagation();
    }
  }

  /**
   * Prepares the bumper and plays it ONLY if the next conditions allows it.
   * 
   * ``Condition 1:`` The song must be the first one the user plays of the current week.
   * ``Condition 2:`` The current week has changed.
   * ``Condition 3:`` The bumper video file exist in ``videos/videos/bumpers/``.
   * 
   * If any of those checks fail, the function will get skipped.
   * Really proud of this - Honton129
   */
  public function setupBumper():Bool
  {
    trace("Attempting to play the bumper...");

    var curVariation = PlayState.instance.currentVariation;
    var songLowercase = PlayState.instance.currentSong.id.toLowerCase();

    currentWeek = getLevel(songLowercase, curVariation);
    lastWeek = getLevel(lastSong, lastVariation);
    shouldReset();

    trace('The current week is: $currentWeek');
    isPlaying = false;

    if (!RemnantsOptions.getBumperOption() || currentWeek == null || !Assets.exists(Paths.videos('bumpers/$currentWeek')))
    {
      trace('Bumpers disabled: ${!RemnantsOptions.getBumperOption()}');
      trace('Video exists: ${Assets.exists(Paths.videos('bumpers/$currentWeek'))}');
      trace('Current week is null: ${currentWeek == null}');

      trace('One or more conditions are present, skipping video!');
      playedBumper = true;
    }

    lastVariation = curVariation;
    lastSong = songLowercase;

    if (playedBumper) trace('The bumper was already played!');
    if (isFirstOfWeek && !playedBumper)
    {
      isPlaying = true;
      disableUpdateNext = false;
      playedBumper = true;

      trace('Playing the bumper "$currentWeek"');

      VideoCutscene.play(Paths.videos('bumpers/$currentWeek'));
      if (skipTransitionWeeks.contains(currentWeek))
      {
        VideoCutscene.vid.bitmap.onEncounteredError.add(cutsceneFinishVideo);
        VideoCutscene.vid.bitmap.onEndReached.add(cutsceneFinishVideo);
      }

      VideoCutscene.onVideoEnded.add(() -> {
        isPlaying = false;
      });

      return true;
    }

    return false;
  }

  public function cutsceneFinishVideo():Void
  {
    FlxTween.cancelTweensOf(FlxG.camera, ["zoom"]);
    FlxTween.cancelTweensOf(VideoCutscene.blackScreen, ["alpha"]);

    var cutsceneType:CutsceneType = VideoCutscene.cutsceneType;

    FlxTween.tween(VideoCutscene.blackScreen, {alpha: 0}, 0.5,
      {
        ease: FlxEase.quadInOut,
        onComplete: function(twn:FlxTween) {
          PlayState.instance.remove(VideoCutscene.blackScreen);
          VideoCutscene.blackScreen = null;
        }
      });
    VideoCutscene.onVideoEnded.dispatch();
    VideoCutscene.onCutsceneFinish(cutsceneType);
  }

  public function onResume(event:ScriptEvent):Void
  {
    if (!isPlaying || !skipTransitionWeeks.contains(currentWeek) || VideoCutscene.vid != null) return;
    cutsceneFinishVideo();
  }

  /**
   * Checks and sets if ??isFirstOfWeek?? is the first song being played of the week.
   */
  function get_isFirstOfWeek():Bool
  {
    if (currentWeek != null)
    {
      isFirstOfWeek = (currentWeek != lastWeek);
    }

    return isFirstOfWeek;
  }

  /**
   * Checks if ??currentWeek?? or ??currentVariant?? has changed.
   * If any of the mentioned variables has changed since the last bumper, we reset the bumper state.
   */
  public function shouldReset():Void
  {
    if (currentWeek != null)
    {
      if (currentWeek != lastWeek)
      {
        trace("The level has changed, resetting bumper state...");
        playedBumper = false;
        return;
      }
    }

    if (PlayState.instance.currentVariation != null)
    {
      if (PlayState.instance.currentVariation != lastVariation)
      {
        trace("The variation has changed, resetting bumper state...");
        playedBumper = false;
        return;
      }
    }
  }

  /**
   * Function to get the current level ID by looking for ??song?? in all the loaded levels in the registry.
   * If it fails to find a valid match, it returns null.
   * This is also used for get the bumper video path.
   */
  function getLevel(song:String, ?variation:Null<String>):String
  {
    if (song == null || song == '') return null;

    for (levelId in LevelRegistry.instance.listEntryIds())
    {
      var level:Null<Level> = LevelRegistry.instance.fetchEntry(levelId);

      if (level == null)
      {
        trace('Could not find level with id (${levelId})');
        continue;
      }

      var parsedVariation:String = '';
      var songsList:Array<String> = level.getSongs();

      if (variation != null && variation != 'remnants' && variation != 'default') parsedVariation = '-$variation';

      if (specialCases.contains(song))
      {
        trace('The song "$song" is a special case, using special name instead...');
        return '${specialCases[song]}$parsedVariation';
      }

      if (songsList.contains(song))
      {
        trace('Level $levelId has a match with $song!');
        return '$levelId$parsedVariation';
      }
    }

    trace(FlxG.random.bool(5) ? 'Hell na yo ass is tweakin jigsaw' : 'No match found!');
    return null;
  }

  var disableUpdateNext:Bool = false;

  override public function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    // Don't continue an update call while the bumper is playing.
    if (isPlaying)
    {
      if (disableUpdateNext) event.stopPropagation();
      disableUpdateNext = true;
    }
  }
}
