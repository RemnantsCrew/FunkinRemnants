package funkin.remnants.utils;

import funkin.data.freeplay.player.PlayerRegistry;
import funkin.ui.freeplay.FreeplayState;
import funkin.data.song.SongRegistry;
import funkin.util.ReflectUtil;
import haxe.ds.StringMap;

class RemnantsContentUtil
{
  public static var songList(get, never):Array<String>;

  /**
   * Checks if the current playable character is Funkin' their Remnants.
   * @return Bool
   */
  public static function remnantsContentEnabled():Bool
  {
    if (PlayState.instance != null)
    {
      var playerCharacterId:String = PlayerRegistry.instance.getCharacterOwnerId(PlayState.instance?.currentChart?.characters.player);
      return playerCharacterId?.contains('remnants') ?? false;
    }

    // Look through all new characters + the current selected character.
    // If one of them is Funkin' their Remnants, enable remnants content.
    var characters:Array<String> = PlayerRegistry.instance.listNewCharacters();
    characters.push(FreeplayState.rememberedCharacterId);

    for (charId in characters)
    {
      if (charId != null && charId.contains('remnants')) return true;
    }

    return false;
  }

  /**
   * Checks if the player has beaten all the songs in the mod.
   * @return Bool
   */
  public static function hasBeatenAllSongs():Bool
  {
    for (id in SongRegistry.instance.listEntryIds())
    {
      var song:Song = SongRegistry.instance.fetchEntry(id);

      for (variation in song.variations)
      {
        final parsedSong = (variation != Constants.DEFAULT_VARIATION) ? '$id-$variation' : id;

        if (!songList.contains(parsedSong)) continue;

        if (!Save.instance.hasBeatenSong(id, null, variation)) return false;
      }
    }

    return true;
  }

  public static function getChance(id:String):Bool
  {
    final percentage:Float = fetchChances().get(id);
    return FlxG.random.bool(id);
  }

  /**
   * Loads the last remnants character.
   * If everything goes fine, your game will be Funkin' their Remnants!
   */
  public static function loadLastRemnantsChar():Void
  {
    if (!Save.instance.modOptions.exists('lastRemnantsChar')) return;

    FreeplayState.rememberedCharacterId = Save.instance.modOptions.get('lastRemnantsChar');
    Save.instance.modOptions.remove('lastRemnantsChar');
    Save.instance.flush();
  }

  /**
   * Saves the last remnants character.
   * This will make the game remember it when you open it again!
   */
  public static function saveLastRemnantsChar():Void
  {
    if (!FreeplayState.rememberedCharacterId.contains('remnants')) return;

    Save.instance.modOptions.set('lastRemnantsChar', FreeplayState.rememberedCharacterId);
    Save.instance.flush();
  }

  /**
   * Checks if the current song is Funkin' their Remnants.
   * @return Bool
   */
  public static function isRemnantsSong():Bool
  {
    final id:String = PlayState.instance?.currentSong?.id;
    final variation:String = PlayState.instance?.currentChart?.variation;
    final songCheck:String = variation != Constants.DEFAULT_VARIATION ? '$id-$variation' : id;
    return songList.contains(songCheck);
  }

  static var _songList:Array<String> = null;
  static var _chances:StringMap = null;

  static function get_songList():Array<String>
  {
    if (_songList == null)
    {
      var fullText:String = Assets.getText(Paths.txt('ui/remnants-songlist'));
      _songList = fullText.trim().split('\n').map(i -> i.trim());
    }

    return _songList;
  }

  static function fetchChances():StringMap
  {
    if (_chances == null)
    {
      var content:String = Assets.getText(Paths.json('remnants-chances'));
      var json:String = Json.parse(fullText);

      _chances = new StringMap();
      for (field in ReflectUtil.getAnonymousFieldsOf(json))
      {
        final value:Dynamic = ReflectUtil.getAnonymousField(json, field);
        _chances.set(field, value);
      }
    }

    return _chances;
  }
}
