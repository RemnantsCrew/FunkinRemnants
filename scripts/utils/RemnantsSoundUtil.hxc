package funkin.remnants.utils;

/**
 * A couple of extra functions for FunkinSounds.
 */
class RemnantsSoundUtil
{
  public function new()
  {
    super();
  }

  /**
   * Pauses all sounds in the pool.
   */
  public static function pauseAllAudio(musicToo:Bool = false, persistToo:Bool = false):Void
  {
    for (sound in FunkinSound.pool)
    {
      if (sound == null) continue;
      if (!persistToo && sound.persist) continue;
      if (!musicToo && sound == FlxG.sound.music) continue;
      if (!sound.isPlaying) continue;
      sound.pause();
    }
  }

  /**
   * Resume all sounds in the pool.
   */
  public static function resumeAllAudio(musicToo:Bool = false, persistToo:Bool = false):Void
  {
    for (sound in FunkinSound.pool)
    {
      if (sound == null) continue;
      if (!persistToo && sound.persist) continue;
      if (!musicToo && sound == FlxG.sound.music) continue;
      if (sound.isPlaying) continue;
      sound.resume();
    }
  }
}
