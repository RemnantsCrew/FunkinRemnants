package funkin.remnants.songs;

import funkin.mobile.input.ControlsHandler;

class RemnantsRemnantsSong extends SugarCrashRemnantsSong
{
  var playedDialogue:Bool = false;

  public function new()
  {
    super('remnants',
      {
        variation: 'remnants'
      });
  }

  function onCountdownStart(event:ScriptEvent):Void
  {
    super.onCountdownStart(event);

    if (PlayState.instance.isChartingMode && !playedDialogue) playedDialogue = true;

    if (!playedDialogue)
    {
      trace('Pausing countdown to play dialogue... (`remnants-remnants`)');
      playedDialogue = true;
      PlayState.instance.disableKeys = true;
      event.cancel();

      FlxTimer.wait(1, () -> {
        var targetDialogue = 'remnants-remnants'; // Normal dialogue

        if (RemnantsContentUtil.getChance('nameEveryRemnant'))
        {
          targetDialogue += "-secret"; // Adds secret dialogue
        }
        else if (!Preferences.naughtyness) targetDialogue += "-censored"; // Adds censored dialogue

        PlayState.instance.disableKeys = false;
        PlayState.instance.startConversation(targetDialogue);
      });
    }
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    playedDialogue = false;
  }

  override function moveComboPopUps():Void
  {
    PlayState.instance.comboPopUps.offsets =
      {
        if (!ControlsHandler.usingExternalInputDevice && Preferences.controlsScheme == 'Arrows')
        {
          // Mobile Offset
          [30, 350];
        }
        else if (Preferences.downscroll)
        {
          // Downscroll Offset
          [550, -190];
        }
        else
        {
          // Upscroll Offset
          [550, 350];
        }
      };

    if (!ControlsHandler.usingExternalInputDevice && Preferences.controlsScheme == 'Arrows') return;
    PlayState.instance.comboPopUps.offsets[0] += (FlxG.width - FlxG.initialWidth) / 2;
  }
}
