package funkin.remnants.songs;

import funkin.mobile.input.ControlsHandler;

class MonsterRemnantsMixSong extends Song
{
  var sequence:SongSequence;

  public function new()
  {
    super('monster',
      {
        variation: 'remnants'
      });
  }

  public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool
  {
    if (currentVariation == 'remnants') return !Save.instance.hasBeatenSong(this.id, null, this.variation);
    return false;
  }

  function onCreate(event:ScriptEvent):Void
  {
    super.onCreate(event);

    PlayState.instance.comboPopUps.offsets =
      {
        if (!ControlsHandler.usingExternalInputDevice && Preferences.controlsScheme == 'Arrows')
        {
          // Mobile Offset
          [30, 350];
        }
        else if (Preferences.downscroll)
        {
          // Downscroll Offset
          [550, -190];
        }
        else
        {
          // Upscroll Offset
          [550, 350];
        }
      };

    if (!ControlsHandler.usingExternalInputDevice && Preferences.controlsScheme == 'Arrows') return;
    PlayState.instance.comboPopUps.offsets[0] += (FlxG.width - FlxG.initialWidth) / 2;
  }

  function onGameOver(event:ScriptEvent):Void
  {
    super.onGameOver(event);
    sequence?.destroy();
  }

  function onSongLoaded(event:SongLoadScriptEvent)
  {
    sequence?.destroy();

    var sequenceData = [
      {
        time: 0,
        callback: () -> {
          PlayState.instance.currentStage.changeAmbiance(true, 0.0001);
          PlayState.instance.currentStage.vignette.alpha = 1;
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 0.9}, 6.79, {ease: FlxEase.smootherStepOut});
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(64) / 1000,
        callback: () -> {
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 0.8}, 6.79, {ease: FlxEase.backIn});
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(96) / 1000,
        callback: () -> {
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 0.6}, 6.79, {ease: FlxEase.backIn});
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(128) / 1000,
        callback: () -> {
          PlayState.instance.currentStage.changeAmbiance(false, 0.0001);
          PlayState.instance.currentStage.vignette.alpha = 0.0001;
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(227) / 1000,
        callback: () -> {
          PlayState.instance.currentStage.changeAmbiance(true, 0.56);
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 0.7}, 0.56);
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(323) / 1000,
        callback: () -> {
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 0.8}, 1.12, {ease: FlxEase.expoInOut});
        }
      },

      {
        time: Conductor.instance.getBeatTimeInMs(340) / 1000,
        callback: () -> {
          FlxTween.tween(PlayState.instance.currentStage.vignette, {alpha: 1}, 6.79);
        }
      },
    ];

    sequence = new SongSequence(sequenceData);
    sequence.startTime = 0;
  }

  function onDestroy(event:ScriptEvent):Void
  {
    super.onDestroy(event);

    sequence?.destroy();
  }
}
