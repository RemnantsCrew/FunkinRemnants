package funkin.remnants;

import flixel.group.FlxTypedGroup;
import animate.FlxAnimate;
import flixel.FlxSprite;
import flixel.FlxState;

/**
 * It's time to make Remnants peak.
 */
class GoodRemnants extends Module
{
  /**
   * The highest and lowest that skew should be set to.
   */
  public static final SKEW_RANGE:Array<Float> = [-5, 5];

  /**
   * The highest and lowest that scale should be set to.
   */
  public static final SCALE_RANGE:Array<Float> = [0, 2];

  /**
   * The highest and lowest that angle should be set to.
   */
  public static final ANGLE_RANGE:Array<Float> = [0, 359];

  public function new()
  {
    super('goodRemnants');
  }

  override public function onUpdate(event:UpdateScriptEvent):Void
  {
    super.onUpdate(event);

    if (FlxG.keys.justPressed.F10)
    {
      applyToAllChildren(FlxG.state);
    }
  }

  public function applyToAllChildren(basic:FlxBasic):Void
  {
    if (basic == null) return;

    if (Std.isOfType(basic, FlxAnimate))
    {
      basic.skew.x = FlxG.random.float(SKEW_RANGE[0], SKEW_RANGE[1]);
      basic.skew.y = FlxG.random.float(SKEW_RANGE[0], SKEW_RANGE[1]);
    }

    if (Std.isOfType(basic, FlxSprite))
    {
      basic.scale.x = FlxG.random.float(SCALE_RANGE[0], SCALE_RANGE[1]);
      basic.scale.y = FlxG.random.float(SCALE_RANGE[0], SCALE_RANGE[1]);

      basic.angle = FlxG.random.float(ANGLE_RANGE[0], ANGLE_RANGE[1]);
    }

    if (Std.isOfType(basic, FlxState))
    {
      for (child in basic.subState?.members ?? [])
      {
        applyToAllChildren(child);
      }
    }

    if (Std.isOfType(basic, FlxTypedGroup))
    {
      for (child in basic.members ?? [])
      {
        applyToAllChildren(child);
      }
    }
  }
}
