package funkin.remnants.characters;

class DarnellRemnantsCharacter extends AnimateAtlasCharacter
{
  function new()
  {
    super('darnell-remnants');
  }

  function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    // Precache the sounds used in 2hot.
    for (snd in ['Darnell_Lighter', 'Kick_Can_UP', 'Kick_Can_FORWARD'])
    {
      FunkinMemory.cacheSound(Paths.sound(snd, "weekend1"));
    }

    FlxG.signals.postUpdate.addOnce(checkAbotArm);
  }

  function checkAbotArm():Void
  {
    var hasAbot:Bool = PlayState.instance?.currentStage?.getGirlfriend()?.scriptHas('abot') ?? true;

    for (symbolName in ["abot arm", "abot hand"])
    {
      var symbol:SymbolItem = this.library.getSymbol(symbolName);
      symbol.timeline.forEachLayer((layer:Layer) -> layer.visible = hasAbot);
    }
  }

  function onNoteHit(event:HitNoteScriptEvent)
  {
    // Override the hit note animation.
    switch (event.note.kind)
    {
      case "weekend-1-lightcan":
        holdTimer = 0;
        playLightCanAnim();
      case "weekend-1-kickcan":
        holdTimer = 0;
        playKickCanAnim();
      case "weekend-1-kneecan":
        holdTimer = 0;
        playKneeCanAnim();
      default:
        super.onNoteHit(event);
    }
  }

  /**
   * Play the animation where Darnell kneels down to light the can.
   */
  function playLightCanAnim()
  {
    this.playAnimation('lightCan', true, true);
    FunkinSound.playOnce(Paths.sound('Darnell_Lighter'));
  }

  /**
   * Play the animation where Darnell kicks the can into the air.
   */
  function playKickCanAnim()
  {
    this.playAnimation('kickCan', true, false);
    FunkinSound.playOnce(Paths.sound('Kick_Can_UP'));
  }

  /**
   * Play the animation where Darnell knees the can in Pico's direction.
   */
  function playKneeCanAnim()
  {
    this.playAnimation('kneeCan', true, true);
    FunkinSound.playOnce(Paths.sound('Kick_Can_FORWARD'));
  }
}
