package funkin.remnants.menus;

import flixel.graphics.frames.FlxBitmapFont;
import funkin.play.scoring.ScoringRank;
import flixel.group.FlxTypedGroup;
import flixel.util.FlxGradient;
import funkin.play.ResultState;
import flixel.math.FlxPoint;
import flixel.util.FlxColor;

class RemnantsResults extends Module
{
  public var resultState(get, never):ResultState;

  var isPico(get, never):Bool;

  public function new()
  {
    super('remnantsResults', 1000, {state: ResultState});
  }

  override public function onSubStateOpenEnd(event:SubStateScriptEvent):Void
  {
    super.onSubStateOpenEnd(event);
    if (resultState != event.targetState) return;

    final flashColor:FlxColor = isPico ? 0xFF00591D : 0xFF000D59;
    resultState.bgFlash?.makeGraphic(FlxG.width, FlxG.height, flashColor);

    setupGradients();
    setupMiscellaneous();
    setupTallies();
    setupClearPercentages();
    setupSongFont();
    setupScroll();
  }

  public function setupGradients():Void
  {
    final gradientColor:FlxColor = isPico ? 0xFF003300 : 0xFF000C33;
    final data:BitmapData = FlxGradient.createGradientBitmapData(1, FlxG.height, [0xFF000000, gradientColor], 90);

    final bg:FlxSprite = findByZ(10);
    if (bg == null) return;

    bg.pixels = data;
    bg.color = FlxColor.BLACK;

    bg.scale.x = FlxG.width;
    bg.updateHitbox();

    FlxTween.color(bg, 1.0, FlxColor.BLACK, FlxColor.WHITE, {ease: FlxEase.quartInOut});
  }

  public function setupMiscellaneous():Void
  {
    // Falling Sound System
    final soundSystem:FunkinSprite = findByZ(1100);
    soundSystem?.frames = Paths.getSparrowAtlas("resultScreen/soundSystem-remnants");
    soundSystem?.animation.addByPrefix("idle", "sound system", 24, false);

    // Difficulty Sprite
    var diffSpr:String = 'diff_' + resultState.params?.difficultyId ?? Constants.DEFAULT_DIFFICULTY;
    resultState.difficulty.loadGraphic(Paths.image('resultScreen/$diffSpr-remnants'));

    // Results Text
    final resultsAnim:FunkinSprite = resultState.resultsAnim;
    resultsAnim?.frames = Paths.getSparrowAtlas("resultScreen/resultsText-remnants");
    resultsAnim?.animation.addByPrefix("result", "results instance 1", 24, false);
  }

  public function setupTallies():Void
  {
    // Ratings
    final ratingsPopin:FunkinSprite = resultState.ratingsPopin;
    ratingsPopin?.frames = Paths.getSparrowAtlas("resultScreen/ratingsPopin-remnants");
    ratingsPopin?.animation.addByPrefix("idle", "Categories", 24, false);

    // Score Text
    final scorePopin:FunkinSprite = resultState.scorePopin;
    scorePopin?.frames = Paths.getSparrowAtlas("resultScreen/scorePopin-remnants");
    scorePopin?.animation.addByPrefix("score", "tally score", 24, false);

    // Highscore Text
    final highscoreNew:FlxSprite = resultState.highscoreNew;
    highscoreNew?.frames = Paths.getSparrowAtlas("resultScreen/highscoreNew-remnants");
    highscoreNew?.animation.addByPrefix("new", "highscoreAnim0", 24, false);

    // Tallie Numbers
    final ratingGrp:FlxTypedGroup = findByZ(1200, FlxTypedGroup);
    for (i in 0...(ratingGrp?.members?.length ?? 0))
    {
      waitWithPreDraw((0.3 * i) + 1.20, () -> {
        var tallie:TallyCounter = ratingGrp.members[i];

        FlxTween.globalManager.forEachTweensOf(tallie, null, (twn:FlxTween) -> {
          var numsDone:Array<TallyNumber> = [];
          twn.onUpdate = _ -> {
            for (num in tallie.members)
            {
              if (numsDone.contains(num)) continue;

              final currentAnimation:String = num.animation?.curAnim?.name ?? '0';
              num.frames = Paths.getSparrowAtlas("resultScreen/tallieNumber-remnants");

              for (i in 0...10)
              {
                num.animation.addByPrefix(i, '$i small', 24, false);
              }

              num.animation.play(currentAnimation, true);
              num.updateHitbox();
              numsDone.push(num);
            }
          };
        });
      });
    }
  }

  public function setupClearPercentages():Void
  {
    function setup(clearPercent:ClearPercentCounter):Void
    {
      var realNumber:Int = clearPercent.curNumber;
      var realNumberChanged:Bool = clearPercent.numberChanged;

      clearPercent.curNumber = 100;
      clearPercent.drawNumbers();

      // Percent Text
      final clearPercentText:FunkinSprite = clearPercent.members[0];
      clearPercentText.loadTexture('resultScreen/clearPercent/clearPercentText${clearPercent.small ? 'Small' : ''}-remnants');

      // Percent Numbers
      for (number in clearPercent.members)
      {
        if (clearPercentText == number) continue;

        final currentAnimation:String = number.animation?.curAnim?.name ?? '0';
        final digitIndex:Int = clearPercent.members.indexOf(number);
        final variant:Bool = digitIndex >= 2;

        number.frames = Paths.getSparrowAtlas('resultScreen/clearPercent/clearPercentNumber${clearPercent.small ? 'Small' : variant ? 'Right' : 'Left'}-remnants');

        for (i in 0...10)
        {
          number.animation.addByPrefix('$i', 'number $i ', 24, false);
        }

        number.animation.play(currentAnimation, true);
        number.updateHitbox();
      }

      clearPercent.curNumber = realNumber;
      clearPercent.numberChanged = realNumberChanged;
    }

    setup(resultState.clearPercentSmall);

    waitWithPreDraw(37 / 24, () -> {
      final clearPercentCounter:ClearPercentCounter = findByZ(450);
      if (clearPercentCounter != null) setup(clearPercentCounter);
    });
  }

  public function setupSongFont():Void
  {
    final fontLetters:String = 'AaBbCcDdEeFfGgHhiIJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz:1234567890';
    resultState.songName.font = FlxBitmapFont.fromMonospace(Paths.image('resultScreen/tardlingSpritesheet-remnants'), fontLetters, FlxPoint.get(49, 62));

    final songText:String = resultState.songName.text;
    resultState.songName.text = '';
    resultState.songName.text = songText;
  }

  public function setupScroll():Void
  {
    final verTextAsset:String = ScoringRank.getVerTextAsset(resultState.rank);
    final horTextAsset:String = ScoringRank.getHorTextAsset(resultState.rank);

    waitWithPreDraw(ScoringRank.getFlashDelay(resultState.rank), () -> {
      final rankTextVert:FlxBackdrop = findByZ(990);
      rankTextVert?.loadGraphic(Paths.image('${verTextAsset}-remnants'));

      final rankTextBacks:Array<FlxBackdrop> = findAllByZ(100);
      for (backdrop in rankTextBacks)
      {
        backdrop?.loadGraphic(Paths.image('${horTextAsset}-remnants'));
        backdrop?.alpha = 0.5;
      }
    });
  }

  function findByZ(zIndex:Int, ?classType:Dynamic = null):FlxBasic
  {
    var allOfThem:Array<FlxBasic> = findAllByZ(zIndex, classType);

    return allOfThem[0];
  }

  function findAllByZ(zIndex:Int, ?classType:Dynamic = null):Array<FlxBasic>
  {
    return [
      for (member in resultState?.members ?? [])
      {
        if (member.zIndex != zIndex) continue;
        if (classType != null && !Std.isOfType(member, classType)) continue;

        member;
      }
    ];
  }

  function waitWithPreDraw(time:Float, callback:Void->Void):Void
  {
    FlxTimer.wait(time, () -> FlxG.signals.preDraw.addOnce(callback));
  }

  function get_resultState():ResultState
  {
    var subState:FlxSubstate = FlxG.state?.subState;

    if (!Std.isOfType(subState, ResultState) || !subState.playerCharacterId.contains('remnants')) return null;

    return subState;
  }

  function get_isPico():Bool
  {
    return resultState?.playerCharacterId.contains('pico') ?? false;
  }
}
