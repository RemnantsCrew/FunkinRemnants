package funkin.remnants.menus;

import funkin.modding.module.ModuleHandler;
import funkin.ui.mainmenu.MainMenuState;
import funkin.ui.title.TitleState;
import funkin.util.WindowUtil;
import funkin.ui.UIState;
import flixel.FlxSprite;

class RemnantsMainMenu extends Module
{
  public function new()
  {
    super('remnantsMainMenu', 1000, {state: MainMenuState});
  }

  var backSpr:FunkinSprite = null;
  var newCredits:FunkinSprite = null;
  var backSpaced:Bool = false;

  #if !mobile
  override public function onStateChangeBegin(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeBegin(event);

    if (backSpaced
      || backSpr == null
      || !RemnantsContentUtil.remnantsContentEnabled()
      || !Std.isOfType(FlxG.state, MainMenuState)
      || !FlxG.state.uiStateMachine.is(UIState.Exiting)
      || !FlxG.state.controls.BACK_P) return;

    // I don't like going back to the title instantly....
    backSpaced = true;
    backSpr.animation.play('press', true);

    // If the plush button is absent, we apply the offset normally.
    var qtPlush = ModuleHandler.getModule("QtPlushMenuButton")?.plushButton;
    backSpr.setPosition(FlxG.width - backSpr.width, qtPlush == null ? FlxG.height - backSpr.height : 0);

    FlxTimer.wait(0.5, () -> {
      FlxG.switchState(() -> new TitleState());
      backSpr = null;
    });

    event.cancel();
  }
  #end

  override public function onStateChangeEnd(event:StateChangeScriptEvent):Void
  {
    super.onStateChangeEnd(event);

    addRemnantsMainMenuItems(event.targetState);
  }

  public function addRemnantsMainMenuItems(state:FlxState):Void
  {
    if (!RemnantsContentUtil.remnantsContentEnabled() || !Std.isOfType(state, MainMenuState)) return;

    #if !mobile
    backSpr = FunkinSprite.createSparrow(0, 0, 'mainMenu/backspace');
    backSpr.animation.addByPrefix('press', 'backspace PRESSED', 24, false);
    backSpr.animation.addByPrefix('idle', 'backspace to exit', 24, true);
    backSpr.animation.play('idle', true);

    backSpr.setPosition(FlxG.width - backSpr.width + 15, FlxG.height - backSpr.height + 50);

    backSpr.scrollFactor.set();
    state.add(backSpr);

    backSpaced = false;
    #end

    // Only change the merch sprite if the user has upgraded.
    if (state.hasUpgraded)
    {
      var merchItem:FlxSprite = state.menuItems.getItem('merch');

      var prevAnim:String = merchItem?.animation?.curAnim?.name;
      var item = FlxG.random.bool(50) ? 'kickstarter' : FlxG.random.bool(50) ? 'goodies' : 'donate';

      merchItem.frames = Paths.getSparrowAtlas('mainMenu/' + item);
      merchItem.animation.addByPrefix('idle', item + ' idle', 24);
      merchItem.animation.addByPrefix('selected', item + ' selected', 24);
      merchItem.changeAnim(prevAnim);

      // Replace the callback so it opens or the kickstarter, or itch.io instead of the merch page.
      merchItem.callback = item == 'donate' ? selectDonate : item == 'goodies' ? selectGoodies : selectKickstarter;
    }

    if (Save.instance.modOptions.exists('seenRemnantsCredits')) return;

    var creditsMenuItem:FlxSprite = state.menuItems.getItem('credits');

    newCredits = FunkinSprite.createSparrow((creditsMenuItem?.x ?? 0) + 200, (creditsMenuItem?.y ?? 0) - 80, 'freeplay/freeplayCapsule/new');
    newCredits.scrollFactor.set(creditsMenuItem?.scrollFactor?.x ?? 1, creditsMenuItem?.scrollFactor?.y ?? 1);
    newCredits.animation.addByPrefix('newAnim', 'NEW notif', 24, true);
    newCredits.animation.play('newAnim', true);
    newCredits.scale.set(1.25, 1.25);
    newCredits.updateHitbox();
    state.add(newCredits);
  }

  function selectDonate()
  {
    // Can't use Referral so it might not work on HTML5.
    WindowUtil.openURL("https://ninja-muffin24.itch.io/funkin");
    FlxG.state?.uiStateMachine?.transition(UIState.Idle);
  }

  function selectKickstarter()
  {
    // Can't use Referral so it might not work on HTML5.
    WindowUtil.openURL("https://www.kickstarter.com/projects/funkin/friday-night-funkin-the-full-ass-game");
    FlxG.state?.uiStateMachine?.transition(UIState.Idle);
  }

  function selectGoodies()
  {
    // Can't use Referral so it might not work on HTML5.
    WindowUtil.openURL("https://www.goodsmile.info/en/product/13980/Nendoroid+Boyfriend.html");
    FlxG.state?.uiStateMachine?.transition(UIState.Idle);
  }

  override function onUpdate(event:UpdateScriptEvent)
  {
    super.onUpdate(event);

    if (Std.isOfType(FlxG.state, MainMenuState) && newCredits != null)
    {
      var creditsMenuItem:FlxSprite = FlxG.state?.menuItems?.getItem('credits');
      newCredits.visible = creditsMenuItem?.visible ?? false;
      newCredits.alpha = creditsMenuItem?.alpha ?? 0;
    }
  }
}
